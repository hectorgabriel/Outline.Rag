{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RagDatabase": "Host=localhost;Port=5433;Database=outline_rag;Username=rag"
  },
  "Outline": {
    "BaseUrl": "http://localhost:3000/",
    "ApiToken": "",
    "WebhookSigningSecret": "",
    "AccessCacheDuration": "00:05:00"
  },
  "Auth": {
    "Oidc": {
      "Authority": "",
      "Audience": "",
      "EmailClaim": "email"
    },
    "Gateway": {
      "ApiKey": "",
      "UserEmailHeader": "X-OpenWebUI-User-Email"
    }
  },
  "RateLimits": {
    "SearchPerMinute": 60,
    "AnswersPerMinute": 10
  },
  "VectorStore": {
    "CollectionName": "outline_chunks"
  },
  "AI": {
    "Chat": {
      "Provider": "Anthropic",
      "Model": "claude-opus-5",
      "MaxOutputTokens": 16000
    },
    "Embeddings": {
      "Provider": "Ollama",
      "Model": "bge-m3",
      "Endpoint": "http://localhost:11434",
      "Dimensions": 1024
    }
  },
  "Rag": {
    "TopK": 6,
    "MinScore": 0.3,
    "MaxChunkTokens": 512,
    "ChunkOverlapTokens": 64
  }
}
